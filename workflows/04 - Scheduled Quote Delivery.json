      "id": "e49bf9bc-2899-42b3-b9cb-611dee3daf8c",
      "name": "Get Active Subscribers"
    },
    {
      "parameters": {
        "jsCode": "const today = $now.setZone('Europe/London').weekday;\n\nreturn $input.all().filter(item => {\n  const frequency = item.json.Frequency;\n  const submittedAt = item.json.submittedAt;\n\n  if (frequency === 'Daily') return true;\n\n  if (frequency === 'Weekly' && submittedAt) {\n    const subscriptionDay = DateTime.fromISO(submittedAt)\n      .setZone('Europe/London')\n      .weekday;\n\n    return subscriptionDay === today;\n  }\n\n  return false;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        0
      ],
      "id": "8140a280-917c-46ed-9001-db7f170cf75f",
      "name": "Filter Subscribers Due Today"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_GOOGLE_SHEETS_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "RESELECT_SHEET_QUOTE_LIBRARY",
          "mode": "id"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Status",
              "lookupValue": "Available"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        208,
        0
      ],
      "id": "8e303286-bcb3-4361-9857-d303fcd7d1ca",
      "name": "Get Available Quotes",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const subscribers = $('Filter Subscribers Due Today').all();\nconst quotes = $input.all().map(item => item.json);\n\nconst selectedQuotes = new Map();\n\nreturn subscribers.flatMap(item => {\n  const subscriber = item.json;\n  const category = subscriber['Quote Category'];\n\n  // Select one quote per category, only once\n  if (!selectedQuotes.has(category)) {\n    const available = quotes.filter(\n      quote => quote.Category === category\n    );\n\n    if (available.length === 0) return [];\n\n    const randomIndex = Math.floor(Math.random() * available.length);\n    selectedQuotes.set(category, available[randomIndex]);\n  }\n\n  const quote = selectedQuotes.get(category);\n\n  return [{\n    json: {\n      Email: subscriber.Email,\n      Category: category,\n      Quote: quote.Quote,\n      Author: quote.Author,\n      QuoteID: quote.ID,\n      QuoteRow: quote.row_number,\n      UnsubscribeToken: subscriber['Unsubscribe Token']\n    }\n  }];\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        0
      ],
      "id": "25287ca9-a7d2-4807-8b3a-027e61d09f0f",
      "name": "Match Quotes to Subscribers"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "=Your {{ $json.Category }} Quote",
        "message": "=<div style=\"max-width:560px;margin:40px auto;\nfont-family:Arial,sans-serif;text-align:center;\">\n\n  <h2>Choose Your Quote</h2>\n\n  <p style=\"color:#777;\">\n    {{ $json.Category }}\n  </p>\n\n  <blockquote style=\"font-size:24px;line-height:1.5;\n  margin:35px 0;\">\n    “{{ $json.Quote }}”\n  </blockquote>\n\n  <p style=\"font-style:italic;\">\n    {{ $json.Author }}\n  </p>\n\n  <hr style=\"border:0;border-top:1px solid #ddd;\n  margin:35px 0;\">\n\n  <p style=\"font-size:12px;color:#888;\">\n    Quotes provided by\n    <a href=\"https://zenquotes.io/\">ZenQuotes.io</a>\n  </p>\n\n  <hr style=\"border:0;border-top:1px solid #ddd;margin:25px 0;\">\n\n<p style=\"font-size:12px;color:#888;\">\n  No longer wish to receive these emails?\n  <a href=\"https://YOUR_N8N_DOMAIN/form/YOUR_UNSUBSCRIBE_FORM_ID?token={{ encodeURIComponent($json.UnsubscribeToken) }}\"\n     style=\"color:#555;text-decoration:underline;\">\n    Unsubscribe here\n  </a>\n</p>\n\n</div>",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        528,
        0
      ],
      "id": "cf2468f5-0a9e-4895-a9b7-18d41432ec6d",
