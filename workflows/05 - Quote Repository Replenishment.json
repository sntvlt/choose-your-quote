    {
      "parameters": {
        "jsCode": "const quotes = $input.all().map((item, index) => ({\n  id: index + 1,\n  quote: item.json.q,\n  author: item.json.a\n}));\n\nreturn [{\n  json: {\n    quotes,\n    count: quotes.length\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        0
      ],
      "id": "103930bd-7312-40e8-a0bb-c5900917cf6b",
      "name": "Prepare AI Classification Batch"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=\nYou are classifying quotations for an email subscription service.\n\nFor each quotation, assign exactly ONE category:\n\nInspiration: Hope, motivation, personal growth.\nHappiness: Joy, gratitude, contentment, wellbeing.\nSuccess: Achievement, ambition, goals, perseverance.\nCourage: Bravery, resilience, overcoming fear.\nRandom: Anything that does not clearly fit the other four.\n\nRules:\n1. Classify by meaning, not simply by matching keywords.\n2. Preserve each original ID.\n3. Do not rewrite the quotations.\n4. Return exactly one classification per quotation.\n5. Use only the five permitted categories.\n6. Return valid JSON only, without Markdown.\n\nOutput format:\n{\n  \"classifications\": [\n    {\"id\": 1, \"category\": \"Inspiration\"}\n  ]\n}\n\nQuotations to classify:\n\n{{ JSON.stringify($json.quotes) }}\n",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        736,
